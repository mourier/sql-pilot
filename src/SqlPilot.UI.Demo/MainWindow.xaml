<Window x:Class="SqlPilot.UI.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SqlPilot.UI.Controls;assembly=SqlPilot.UI"
        xmlns:vm="clr-namespace:SqlPilot.UI.ViewModels;assembly=SqlPilot.UI"
        Title="SQL Pilot - UI Demo"
        Width="500" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Scope / status bar -->
    <Border Grid.Row="0" Padding="4,2" Background="#2D2D30">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="IndexStatus" Grid.Column="0" FontSize="11"
                   Foreground="#9D9D9D" VerticalAlignment="Center" Text="Not indexed." />
        <ToggleButton x:Name="ScopeButton" Grid.Column="1" Content="Scope" Padding="8,2"
                      FontSize="11"
                      Checked="ScopeButton_Toggled" Unchecked="ScopeButton_Toggled" />
      </Grid>
    </Border>

    <!-- Scope tree -->
    <Border x:Name="ScopePanel" Grid.Row="1" Visibility="Collapsed"
            Padding="4,2" Background="#252526">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="11" Margin="2,0,0,2"
                   Foreground="#9D9D9D" Text="{Binding SummaryText}" />

        <TreeView Grid.Row="1" x:Name="ScopeTree"
                  ItemsSource="{Binding Servers}"
                  MaxHeight="240"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="#D4D4D4">
          <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type vm:ServerScopeNode}" ItemsSource="{Binding Databases}">
              <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          IsThreeState="False"
                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Margin="4,0,0,0" FontWeight="SemiBold" Foreground="#D4D4D4" />
              </StackPanel>
            </HierarchicalDataTemplate>
            <DataTemplate DataType="{x:Type vm:DatabaseScopeNode}">
              <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Margin="4,0,0,0" Foreground="#D4D4D4" />
              </StackPanel>
            </DataTemplate>
          </TreeView.Resources>
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="True" />
            </Style>
          </TreeView.ItemContainerStyle>
        </TreeView>
      </Grid>
    </Border>

    <controls:SearchControl x:Name="SearchPanel" Grid.Row="2" />
  </Grid>
</Window>
