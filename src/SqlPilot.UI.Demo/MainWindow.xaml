<Window x:Class="SqlPilot.UI.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SqlPilot.UI.Controls;assembly=SqlPilot.UI"
        Title="SQL Pilot - UI Demo"
        Width="500" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Scope / status bar -->
    <Border Grid.Row="0" Padding="4,2" Background="#2D2D30">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="IndexStatus" Grid.Column="0" FontSize="11"
                   Foreground="#9D9D9D" VerticalAlignment="Center" Text="Not indexed." />
        <ToggleButton x:Name="ScopeButton" Grid.Column="1" Padding="6,2"
                      AutomationProperties.Name="Scope"
                      ToolTip="Scope — choose which servers and databases to search (Alt+S)">
          <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                     VerticalAlignment="Center" />
        </ToggleButton>
      </Grid>
    </Border>

    <!-- Scope tree -->
    <Border x:Name="ScopePanel" Grid.Row="1"
            Visibility="{Binding IsChecked, ElementName=ScopeButton, Converter={StaticResource BoolToVis}}"
            Padding="4,2" Background="#252526">
      <controls:ScopeControl x:Name="ScopePanelContent" Foreground="#D4D4D4" />
    </Border>

    <controls:SearchControl x:Name="SearchPanel" Grid.Row="2" />
  </Grid>
</Window>
